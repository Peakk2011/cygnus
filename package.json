{
    "name": "@peakk/cygnus",
    "version": "1.0.0",
    "description": "A lightweight HTML preprocessor for native '.html' component files.",
    "type": "module",
    "main": "./cygnus/index.js",
    "module": "./cygnus/index.js",
    "exports": {
        ".": "./cygnus/index.js",
        "./lib/*": "./cygnus/lib/*",
        "./templates/*": "./templates/*",
        "./package.json": "./package.json"
    },
    "files": [
        "cygnus/",
        "templates/",
        "README.md",
        "LICENSE.md"
    ],
    "keywords": [
        "html",
        "preprocessor",
        "components",
        "vite",
        "cygnus html"
    ],
    "author": "Peakk",
    "license": "MIT",
    "peerDependencies": {
        "vite": "^6.0.0"
    },
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/peakk2011/cygnus.git"
    },
    "bugs": "https://github.com/peakk2011/cygnus/issues",
    "homepage": "https://github.com/peakk2011/cygnus#readme"
}